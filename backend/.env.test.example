# Throwaway compose MariaDB (compose.test.yaml). These credentials are fixed,
# public test values and safe to commit. Export or set inline; do not put them
# in .env.
#   docker compose -f compose.test.yaml up -d --wait
#
# Optional host port override (default 33306); guards read the same variable.
# TEST_DB_PORT=33306

# Migration authoring (prisma migrate dev / migrate diff):
DATABASE_URL="mysql://root:test@127.0.0.1:33306/lodging_migrate"
SHADOW_DATABASE_URL="mysql://root:test@127.0.0.1:33306/lodging_shadow"

# Go integration tests (must be compose lodging_test or lodging_e2e):
TEST_DATABASE_URL="root:test@tcp(127.0.0.1:33306)/lodging_test?parseTime=True"

# E2E API server:
GORM_DATABASE_URL_E2E="root:test@tcp(127.0.0.1:33306)/lodging_e2e?charset=utf8mb4&parseTime=True"
