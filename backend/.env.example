DATABASE_URL="mysql://root:root@localhost:3306/sakunoie"
GORM_DATABASE_URL="root:root@tcp(localhost:3306)/sakunoie?charset=utf8mb4&parseTime=True&loc=Local"
# 重要: 本番では必ず変更すること。release モードでこの値のまま、または 12 文字未満で起動すると警告が出る。
# 招待コードは長くランダムな値にする。クライアントごとの試行回数制限（5 回/分）は、クライアントの
# アドレスを転送するリバースプロキシの背後でのみ効く。それ以外では全員共通の上限（30 回/分）になる。
INVITE_CODE="SAKU-26-ABCD"
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="sakunoie"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_USE_SSL="false"
S3_PUBLIC_URL="http://localhost:9000/sakunoie"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-flash-1.5"
TRANSLATION_PROVIDER="mymemory"
# 場所検索（docs/spot-search.md）。空なら osm（OpenStreetMap 系の公開サービス、キー不要）。
# google は GOOGLE_MAPS_API_KEY があるときだけ有効。それ以外の値は検索を無効にする（503）。
PLACE_PROVIDER="osm"
# 公開の Nominatim / Photon を使う場合は必ず設定する。サイト名と連絡先を入れること（Nominatim の利用規約）。
PLACE_USER_AGENT=""
# 公開サービスへの呼び出し間隔（ミリ秒）。公開の Nominatim を使う間は 1000 未満にしない。
PLACE_UPSTREAM_MIN_INTERVAL_MS="1100"
# 自前または有償のインスタンスを使うときだけ設定する（空なら公開サービス）。
NOMINATIM_BASE_URL=""
PHOTON_BASE_URL=""
# サーバー側専用の Google Maps Platform キー。ブラウザに渡さない。
GOOGLE_MAPS_API_KEY=""
PORT="8080"
GIN_MODE="debug"
