# Copy to .env and fill in. Placeholders only; never commit real values.
# cmd/server and cmd/admin-grant load ./.env automatically (already-set
# variables win; SKIP_DOTENV=1 disables it).

# --- Database (shared dev server) ---
# Prisma: used only for `migrate deploy`, `migrate status` and the seed
# (`npm run db:deploy:dev`). Dev-only Prisma commands (migrate dev/diff/reset,
# db push) are refused by prisma.config.ts unless DATABASE_URL and
# SHADOW_DATABASE_URL are set inline to the compose DB (see .env.test.example).
DATABASE_URL="mysql://<user>:<password>@<host>:<port>/lodging-master-dev"
# Go (GORM). Any valid go-sql-driver DSN; the app forces loc=UTC and
# time_zone='+00:00' at connect time.
GORM_DATABASE_URL="<user>:<password>@tcp(<host>:<port>)/lodging-master-dev?charset=utf8mb4&parseTime=True&loc=Local"
# Optional. Compose lodging_shadow only, set inline for migrate dev/diff.
# SHADOW_DATABASE_URL=

# --- App ---
# Required, no default: development | test | production
APP_ENV=development
PORT=8080
# Listen IP. Default: 127.0.0.1 with APP_ENV=production (only cloudflared on the
# same host can connect), every interface otherwise. Must be an IP literal;
# use 0.0.0.0 only when cloudflared runs elsewhere (e.g. another container).
# BIND_ADDR=127.0.0.1

# --- Client IP (rate limiter) ---
# Peers whose CLIENT_IP_HEADER is trusted: only the hop that connects to Go
# (cloudflared: 127.0.0.1,::1 on the same host, or its container IP/subnet).
TRUSTED_PROXIES=127.0.0.1,::1
# The one header read from a trusted peer. Default X-Real-IP; production behind
# Cloudflare Tunnel: CF-Connecting-IP (required with APP_ENV=production; there is
# no default there). X-Forwarded-For and Forwarded are refused
# at startup (client-appendable).
CLIENT_IP_HEADER=X-Real-IP

# --- CORS (the browser calls the API origin directly) ---
# Comma-separated exact origins (scheme://host[:port], lower case, no path or
# trailing slash). Required with APP_ENV=production, e.g.
# https://sakunoie.example. Empty = CORS off (same-origin only, e.g. through the
# dev rewrite). "*" is refused. Credentials are never allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Secrets (base64 of 32 random bytes: `openssl rand -base64 32`) ---
PASSPORT_ENC_KEYS="1:<base64-32-bytes>"
PASSPORT_ENC_ACTIVE_KEY_ID=1
IDEMPOTENCY_HMAC_KEY="<base64-32-bytes>"

# --- Firebase Auth (dev uses the Auth Emulator) ---
# FIREBASE_PROJECT_ID is required (ID token audience). No service-account key
# or ADC is needed: tokens are verified against Google's public certs.
# FIREBASE_AUTH_EMULATOR_HOST disables signature checks, so the server
# refuses it with APP_ENV=production or a project id not starting with demo-.
FIREBASE_PROJECT_ID=demo-sakunoie
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Limits ---
RATE_LIMIT_CREATE_PER_MIN=10
RATE_LIMIT_MANAGE_PER_MIN=60
RATE_LIMIT_SURVEY_PER_MIN=10
SURVEY_MIN_RESPONSES=5
