DATABASE_URL="mysql://root:root@localhost:3306/sakunoie"
GORM_DATABASE_URL="root:root@tcp(localhost:3306)/sakunoie?charset=utf8mb4&parseTime=True&loc=Local"
# 重要: 本番では必ず変更すること。release モードでこの値のまま、または 12 文字未満で起動すると警告が出る。
# 招待コードは長くランダムな値にする。クライアントごとの試行回数制限（5 回/分）は、クライアントの
# アドレスを転送するリバースプロキシの背後でのみ効く。それ以外では全員共通の上限（30 回/分）になる。
INVITE_CODE="SAKU-26-ABCD"
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="sakunoie"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_USE_SSL="false"
S3_PUBLIC_URL="http://localhost:9000/sakunoie"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-flash-1.5"
TRANSLATION_PROVIDER="mymemory"
PORT="8080"
GIN_MODE="debug"
