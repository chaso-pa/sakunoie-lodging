{
  "name": "sakunoie-lodging-backend",
  "private": true,
  "scripts": {
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db execute --file prisma/seed.sql",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:deploy:dev": "bash scripts/db-deploy-dev.sh",
    "db:reset:test": "bash scripts/db-reset-test.sh",
    "setup": "prisma migrate deploy && npm run db:seed"
  },
  "devDependencies": {
    "dotenv": "^16.0.0",
    "prisma": "^7.0.0"
  }
}
