# Copy to .env.local (git-ignored) or export in the shell. Placeholders only; never commit real values.
# Every NEXT_PUBLIC_* value is inlined into the bundles by `next build` (and read when `next dev`
# starts): change it -> rebuild. Setting it on the standalone server at runtime does nothing.

# --- API ---
# Origin of the Go API that the browser calls directly (cross-origin; the API's CORS_ALLOWED_ORIGINS
# must list this site's origin). Origin only: scheme://host[:port], no path. Also added to the CSP
# connect-src of every page. Production: https://api.sakunoie.example. Leave unset to use the rewrite.
NEXT_PUBLIC_API_BASE_URL=
# Dev convenience only, used when NEXT_PUBLIC_API_BASE_URL is unset: /api/* on this origin is rewritten
# to this target (default http://127.0.0.1:8080). Baked into the routes manifest at build time.
# Production does not use it.
# API_PROXY_TARGET=http://127.0.0.1:8080

# --- Firebase Auth (admin console only) ---
# Required unless the Auth Emulator is used. PROJECT_ID must equal the backend FIREBASE_PROJECT_ID.
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project>
# Dev/E2E only: host:port of the Auth Emulator (e.g. 127.0.0.1:9099). When set, the API key may be any
# string and the project defaults to demo-sakunoie. Never set it for production.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
