# Go API that Next.js proxies /api/* to (see next.config.ts `rewrites`).
# Server-side only. Read when `next dev` starts and baked in at `next build`.
API_PROXY_TARGET="http://localhost:8080"

# src/proxy.ts removes X-Forwarded-For and X-Real-IP from /api/* requests before they are proxied, because
# Next.js cannot verify them and a client could forge its address. The API then sees every request as
# coming from this server. Set to "true" ONLY when a reverse proxy you control sits in front of Next.js and
# overwrites these headers itself; they are then passed through unchanged. Read at server start.
TRUST_FORWARDED_HEADERS="false"

# Leave empty so the browser calls the same-origin /api proxy and the session cookie stays same-origin.
NEXT_PUBLIC_API_BASE_URL=""

# Map of the place picker in the post composer (docs/spot-search.md). All three are optional and are
# inlined into the browser bundle at build time, so they must not hold a secret.
# Raster tile URL template ({z}/{x}/{y}, optionally {s} and {r}). Empty = the public openstreetmap.org tile
# server, which needs no key but is best-effort and has a usage policy
# (https://operations.osmfoundation.org/policies/tiles/). Point it at a commercial or self-hosted tile
# source for a deployment with real traffic.
NEXT_PUBLIC_MAP_TILE_URL=""
# Attribution shown on the map, as HTML. Empty = "© OpenStreetMap contributors" with a link to
# https://www.openstreetmap.org/copyright. Set it to whatever the tile source above requires.
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=""
# Highest zoom level the tile source serves. Empty = 19.
NEXT_PUBLIC_MAP_TILE_MAX_ZOOM=""
